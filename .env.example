# Copy this file to .env and fill it in:   cp .env.example .env
# Then start FixFlow:                       docker compose -f docker-compose.prod.yml up -d --build      (or: make prod)
#
# The server checks these when it starts (`bin/rails fixflow:check_config` runs the check by hand) and refuses to start
# with a plain message if a required one is missing or is still an example value. docs/configuration.md lists them all.
# SKIP_CONFIG_CHECK=true turns the check off, for an emergency.

# ══ Required ═════════════════════════════════════════════════════════════════
# Make each secret with the command beside it. Passwords end up inside web addresses, so use these commands (letters
# and digits only) rather than choosing your own.

APP_URL=                            # the address people type in their browser, e.g. http://fixflow.example.com (no slash at the end)
SECRET_KEY_BASE=                    # 64+ characters: openssl rand -hex 64
DEVISE_JWT_SECRET_KEY=              # 32+ characters: openssl rand -hex 48

DB_PASSWORD=                        # openssl rand -hex 24
REDIS_PASSWORD=                     # openssl rand -hex 24
MINIO_ACCESS_KEY=                   # the file storage's login: openssl rand -hex 10
MINIO_SECRET_KEY=                   # openssl rand -hex 24
MQTT_USERNAME=fixflow               # the sensor broker's login; sensors connect to port 1883 with it
MQTT_PASSWORD=                      # openssl rand -hex 24

# ══ The lite install (optional) ══════════════════════════════════════════════
# For a small server (2 GB of memory): no file-storage server and no sensor broker; uploaded files and backups are folders
# on the disk. Take the # off the next line AND delete the four MINIO_* and MQTT_* lines above (the lite install does not
# use them). docs/lite.md says what you give up.
# COMPOSE_FILE=docker-compose.lite.yml

# ══ Published images (optional) ══════════════════════════════════════════════
# A release starts from FixFlow's published images (nothing is built on the server). Leave these out unless you mirror them:
# the registry the images are in (they must be named fixflow-api:<version> and fixflow-web:<version> there), and the version
# (bin/release keeps the default in the compose files equal to the VERSION file; set it to pin another one). docs/install.md.
# FIXFLOW_IMAGE_REPO=ghcr.io/getfixflow
# FIXFLOW_VERSION=

# ══ Optional ═════════════════════════════════════════════════════════════════
# The port the web front door listens on (80 if you leave it out). Include it in APP_URL if it is not 80.
HTTP_PORT=80
APP_HOST=localhost                  # only used in a few email links; APP_URL is the one that matters

# ── HTTPS (optional) ─────────────────────────────────────────────────────────
# FixFlow can serve HTTPS itself (docs/https.md). To turn it on, take the # off the lines below and set APP_URL to
# https://<HTTPS_DOMAIN>. Leave them alone if your company's proxy already provides HTTPS.
# COMPOSE_PROFILES=https
# HTTPS_DOMAIN=fixflow.example.com    # the name people open FixFlow at (name only: no https://, no port)
# HTTPS_MODE=automatic                # automatic: a free Let's Encrypt certificate (the server must be reachable from the
#                                     #   internet on ports 80 and 443) | own-certificate: certs/fixflow.crt and
#                                     #   certs/fixflow.key | internal: FixFlow makes its own (devices must trust it)
# HTTPS_EMAIL=                        # optional: Let's Encrypt writes here before a certificate runs out
# HTTP_PORT=8080                      # the plain-HTTP door moves off 80 ...
# HTTP_BIND=127.0.0.1                 # ... and is closed to the network
# HTTPS_PORT=443                     # the ports the HTTPS front door takes on this server; certificates are
# HTTPS_HTTP_PORT=80                  #   issued and renewed through 80, so change these only to try it out

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Or leave these out and set the mail server under Settings, Email once you are signed in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM=noreply@fixflow.example.com

# ── Sensors ──────────────────────────────────────────────────────────────────
# Sensors sending readings over HTTP use an API key made under Settings, API Keys (not a setting here).
IOT_RETENTION_DAYS=90               # only for a company that has not chosen a limit (Settings, Data Retention)
# MQTT_SUBSCRIBER=true              # true or false: whether THIS process listens to the sensor broker. Leave it out: only the worker does

# ── Features ─────────────────────────────────────────────────────────────────
FIXFLOW_UPDATE_CHECK=true           # false: System Health never asks GitHub for the latest release (for servers with no internet)
SEED_DB=false                       # true loads demo data on start (demo logins use a known password; only for trying it out)
BLOCKED_IPS=

# ── AI (FixFlow Assist, powered by Anthropic Claude) ─────────────────────────
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ══ Set by docker-compose.prod.yml; only needed when you run FixFlow without Docker ═════════════════════════════════
# RAILS_ENV=production
# DATABASE_URL=postgres://fixflow:<DB_PASSWORD>@db:5432/fixflow_production
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# ALLOWED_ORIGINS=<APP_URL>                 # web addresses allowed to call the API from another address
# MINIO_ENDPOINT=http://s3:8333             # the file storage (any S3-compatible server; the names say MINIO for history)
# MINIO_BUCKET=fixflow-uploads
# MINIO_BACKUP_BUCKET=fixflow-backups
# MINIO_REGION=us-east-1
# Keep the nightly backups (the database dump and a copy of the uploaded files) on ANOTHER S3 storage, so they survive
# losing this server. Without these they go to the file storage above, on the same disk as the data.
# BACKUP_S3_ENDPOINT=https://s3.example.com   # leave out for Amazon S3
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=fixflow-backups            # the bucket must already exist
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PATH_STYLE=true                   # false for Amazon S3
# MQTT_HOST=mqtt
# MQTT_PORT=1883
# MQTT_SSL=false
# MQTT_KEEPALIVE=60
# DB_POOL=10
