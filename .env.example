# The server checks these when it starts (`bin/rails fixflow:check_config` runs the check by hand) and refuses to start
# with a plain message if a required one is missing or is still an example value. README: "Environment Variables".
# SKIP_CONFIG_CHECK=true turns the check off, for an emergency.

# ── Application ──────────────────────────────────────────────────────────────
RAILS_ENV=production
SECRET_KEY_BASE=                    # required, 64+ characters: bin/rails secret
APP_HOST=app.fixflow.dev
APP_URL=https://app.fixflow.dev       # where the web app is served; used in invitation links
APP_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://fixflow:password@db:5432/fixflow_production
DB_HOST=db
DB_USER=fixflow                     # only used while waiting for the database to start when DATABASE_URL is not set
DB_PASSWORD=change_me_strong_password
DB_POOL=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:password@redis:6379/0
REDIS_PASSWORD=change_me_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
DEVISE_JWT_SECRET_KEY=              # required, 32+ characters: openssl rand -base64 64
IOT_API_KEY=                        # for sensors sending readings over HTTP (openssl rand -hex 32); without one that route refuses everything

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=fixflow
MQTT_PASSWORD=change_me_strong_password
MQTT_SSL=false
MQTT_KEEPALIVE=60

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=fixflow_minio
MINIO_SECRET_KEY=change_me_strong_password
MINIO_BUCKET=fixflow-uploads
MINIO_BACKUP_BUCKET=fixflow-backups
MINIO_REGION=us-east-1

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@fixflow.dev
SMTP_DOMAIN=fixflow.dev

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,https://app.fixflow.dev

# ── IoT ───────────────────────────────────────────────────────────────────────
IOT_RETENTION_DAYS=90

# ── Security ──────────────────────────────────────────────────────────────────
BLOCKED_IPS=

# ── Features ─────────────────────────────────────────────────────────────────
SEED_DB=false                       # true loads demo data on start (demo logins use a known password; only for trying it out)
ENABLE_API_DOCS=false

# ── AI (FixFlow Assist, powered by Anthropic Claude) ───────────────────────────
ANTHROPIC_API_KEY=your_key_here
AI_ENABLED=true
AI_MODEL=claude-sonnet-4-6
