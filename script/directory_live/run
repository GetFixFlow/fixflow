#!/usr/bin/env bash
# Tries company sign-in against real servers: a Keycloak (OpenID Connect) and an OpenLDAP in Docker, and a FixFlow API on
# a scratch database, then signs in through both the way the web app does (check.rb). Needs Docker, the development setup
# (.env) with Postgres running, and about 1.5 GB of memory. Everything it starts is removed when it ends.
#
# NOTE: check.rb was run against Keycloak 26.0.8 and OpenLDAP 2.7.1 started by hand. This script's Docker start-up
# (the containers, the memberOf overlay, the seed) has not been run end to end: Docker could not pull images on the
# machine it was written on. If a step here fails, the files next to it (the realm, the LDIF files) are what to reuse.
#
#   script/directory_live/run            run the checks and clean up
#   KEEP=1 script/directory_live/run     leave the three servers running afterwards (stop them with script/directory_live/run stop)
set -euo pipefail
cd "$(dirname "$0")/../.."

KC=fixflow-live-keycloak
LDAP=fixflow-live-ldap
KC_PORT=${KC_PORT:-8089}
LDAP_PORT=${LDAP_PORT:-3389}
API_PORT=${API_PORT:-3077}
DB=${DB:-fixflow_live}
KC_IMAGE=${KC_IMAGE:-quay.io/keycloak/keycloak:26.0.8}
LDAP_IMAGE=${LDAP_IMAGE:-osixia/openldap:1.5.0}
PIDFILE=tmp/directory_live.pid
HERE=script/directory_live

stop() {
  [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null || true
  rm -f "$PIDFILE"
  docker rm -f "$KC" "$LDAP" >/dev/null 2>&1 || true
  dropdb --if-exists "$DB" >/dev/null 2>&1 || true
}

if [ "${1:-}" = "stop" ]; then stop; echo "stopped"; exit 0; fi
trap '[ -n "${KEEP:-}" ] || stop' EXIT
stop

echo "== OpenLDAP"
docker run -d --name "$LDAP" --memory 256m -p "127.0.0.1:$LDAP_PORT:389" \
  -e LDAP_ORGANISATION=Acme -e LDAP_DOMAIN=acme.test -e LDAP_ADMIN_PASSWORD=admin -e LDAP_TLS_VERIFY_CLIENT=never \
  "$LDAP_IMAGE" >/dev/null
for _ in $(seq 1 60); do
  docker exec "$LDAP" ldapsearch -x -H ldap://localhost -b dc=acme,dc=test -D cn=admin,dc=acme,dc=test -w admin -s base dn >/dev/null 2>&1 && break
  sleep 2
done
# memberOf, as Active Directory has it, is switched on before anyone is added to a group
docker exec -i "$LDAP" ldapmodify -Y EXTERNAL -H ldapi:/// < "$HERE/memberof.ldif" >/dev/null
docker exec -i "$LDAP" ldapadd -x -H ldap://localhost -D cn=admin,dc=acme,dc=test -w admin < "$HERE/ldap-seed.ldif" >/dev/null
docker cp "$LDAP:/container/service/slapd/assets/certs/ca.crt" tmp/directory_live_ca.crt >/dev/null 2>&1 || true

echo "== Keycloak (this takes a minute)"
docker run -d --name "$KC" --memory 1200m -p "127.0.0.1:$KC_PORT:8080" \
  -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin -e "KC_HOSTNAME=http://localhost:$KC_PORT" \
  -e KC_HTTP_ENABLED=true -e JAVA_OPTS_KC_HEAP="-Xms256m -Xmx768m" \
  -v "$PWD/$HERE/keycloak-realm.json:/opt/keycloak/data/import/realm.json:ro" \
  "$KC_IMAGE" start-dev --import-realm >/dev/null
for _ in $(seq 1 120); do
  curl -fs "http://localhost:$KC_PORT/realms/acme/.well-known/openid-configuration" >/dev/null 2>&1 && break
  sleep 2
done
curl -fs "http://localhost:$KC_PORT/realms/acme/.well-known/openid-configuration" >/dev/null || { docker logs "$KC" | tail -20; echo "Keycloak did not start"; exit 1; }

echo "== FixFlow API on a scratch database ($DB)"
set -a; source .env; set +a
export DATABASE_URL="postgresql://localhost/$DB" APP_URL="http://localhost:${WEB_PORT:-3401}" API_URL="http://localhost:$API_PORT"
export ALLOWED_ORIGINS="$APP_URL"
bin/rails db:create db:schema:load >/dev/null 2>&1
bin/rails runner '
  org = Organization.create!(name: "Acme", subdomain: "acme")
  User.create!(organization: org, email: "admin@acme.test", password: "Ledger-pass-2026-xyz", first_name: "Ada", last_name: "Admin", role: "admin")
' >/dev/null
mkdir -p tmp
bin/rails server -p "$API_PORT" -b 127.0.0.1 >tmp/directory_live_api.log 2>&1 &
echo $! > "$PIDFILE"
for _ in $(seq 1 60); do curl -fs "http://localhost:$API_PORT/api/v1/setup/status" >/dev/null 2>&1 && break; sleep 1; done

echo "== Signing in"
API="http://localhost:$API_PORT" KEYCLOAK="http://localhost:$KC_PORT" LDAP_PORT="$LDAP_PORT" LDAP_CA="$PWD/tmp/directory_live_ca.crt" \
  ruby "$HERE/check.rb"
