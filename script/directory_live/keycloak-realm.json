{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [ { "name": "fixflow-admins" }, { "name": "fixflow-managers" }, { "name": "fixflow-technicians" } ],
  "clients": [
    {
      "clientId": "fixflow",
      "enabled": true,
      "secret": "fixflow-client-secret",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "http://localhost:3077/api/v1/auth/oidc/callback" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    { "username": "alice", "email": "alice@acme.test", "emailVerified": true, "enabled": true, "firstName": "Alice", "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "alice-pass", "temporary": false } ], "groups": [ "/fixflow-admins" ] },
    { "username": "bob", "email": "bob@acme.test", "emailVerified": true, "enabled": true, "firstName": "Bob", "lastName": "Manager",
      "credentials": [ { "type": "password", "value": "bob-pass", "temporary": false } ], "groups": [ "/fixflow-managers" ] },
    { "username": "carol", "email": "carol@acme.test", "emailVerified": true, "enabled": true, "firstName": "Carol", "lastName": "Technician",
      "credentials": [ { "type": "password", "value": "carol-pass", "temporary": false } ], "groups": [ "/fixflow-technicians" ] },
    { "username": "dave", "email": "dave@acme.test", "emailVerified": true, "enabled": true, "firstName": "Dave", "lastName": "Nogroup",
      "credentials": [ { "type": "password", "value": "dave-pass", "temporary": false } ] },
    { "username": "erin", "email": "erin@acme.test", "emailVerified": false, "enabled": true, "firstName": "Erin", "lastName": "Unverified",
      "requiredActions": [], "credentials": [ { "type": "password", "value": "erin-pass", "temporary": false } ], "groups": [ "/fixflow-technicians" ] }
  ]
}
