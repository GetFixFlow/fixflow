<%= t("mail.greeting", name: @user.first_name) %>

<%= t(".body", inviter: @inviter ? @inviter.full_name : t("mail.an_administrator"), organization: @organization.name, role: mail_role(@user.role)) %>
<% if @personal_message %>

"<%= @personal_message %>"
<% end %>

<%= t(".set_password") %>
<%= @invitation_url %>

<%= t(".expiry", time: User::INVITATION_TTL.inspect) %>

<%= t("mail.signature") %>
