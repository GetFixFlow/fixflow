<%= t("mail.greeting", name: @manager.full_name) %>

<%= t(@out ? ".out" : ".low", part: @part.name) %>

<%= mail_fields(
  t(".part") => "#{@part.name}#{" (#{@part.sku})" if @part.sku.present?}",
  t(".on_hand") => "#{@part.quantity_on_hand.to_f} #{@part.unit}",
  t(".reorder_at") => "#{@part.reorder_point.to_f} #{@part.unit}"
) %>

<%= t(".once") %>

<%= t(".see", url: @url) %>

<%= t("mail.signature") %>
