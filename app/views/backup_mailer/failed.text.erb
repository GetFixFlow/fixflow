<%= t("mail.greeting", name: @admin.full_name) %>

<%= t(".body", attempts: DatabaseBackupJob::ATTEMPTS) %>

<%= mail_fields(t(".when") => @failed_at.utc.strftime("%Y-%m-%d %H:%M UTC"), t(".reason") => @reason) %>

<%= t(".what_to_do", time: DatabaseBackupJob::RUNS_AT) %>

<%= t(".see_backups", url: @url) %>

<%= t("mail.signature") %>
