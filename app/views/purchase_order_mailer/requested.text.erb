<%= t("mail.greeting", name: @manager.full_name) %>

<%= t(".intro", person: @order.requested_by&.full_name.presence || t("mail.someone")) %>

<%= mail_fields({ t(".request") => @order.number }.merge(@order.reason.present? ? { t(".why") => @order.reason } : {})) %>

<% @order.lines.each do |line| %>
- <%= line.part.name %>: <%= line.quantity.to_f %> <%= line.part.unit %>
<% end %>

<%= t(".decide", url: @url) %>

<%= t("mail.signature") %>
