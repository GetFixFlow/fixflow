<%= t("mail.greeting", name: @manager.full_name) %>

<%= t(".intro") %>

<% @pm_list.each do |pm| %>
  - <%= pm.name %>
<%= mail_fields(t("mail.asset") => pm.asset&.name || t("mail.not_applicable"), t("mail.priority") => mail_priority(pm.priority), t("mail.was_due") => pm.next_due_at&.strftime("%Y-%m-%d") || t("mail.unknown"), t("mail.days_overdue") => pm.next_due_at ? (Date.today - pm.next_due_at.to_date).to_i : t("mail.not_applicable")).indent(4) %>

<% end %>

<%= t(".outro") %>

<%= t("mail.signature") %>
