<%= t("mail.greeting", name: @user.full_name) %>

<%= t(".intro") %>

<% @pm_list.each do |pm| %>
  - <%= pm.name %>
<%= mail_fields(t("mail.asset") => pm.asset&.name || t("mail.not_applicable"), t("mail.priority") => mail_priority(pm.priority), t("mail.due") => pm.next_due_at&.strftime("%Y-%m-%d") || t("mail.not_set")).indent(4) %>

<% end %>

<%= t(".outro") %>

<%= t("mail.signature") %>
