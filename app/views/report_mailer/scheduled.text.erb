<%= t("mail.greeting", name: @person.full_name) %>

<%= t(".intro", name: @report.name, report: @report.title.downcase, from: mail_day(@result.from), to: mail_day(@result.to)) %>

<% if @report.send_on %>
<%= t(".scheduled", count: @report.recipient_ids.size, sender: @report.user.full_name, day: I18n.t("date.day_names")[@report.send_on], first_name: @report.user.first_name) %>
<% else %>
<%= t(".manual") %>
<% end %>

<%= t(".see", url: @url) %>

<%= t("mail.signature") %>
