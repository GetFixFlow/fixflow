<%= t("mail.greeting", name: @manager.full_name) %>

<%= t(".intro") %>

<%= mail_fields(
  t("mail.work_order") => @work_order.work_order_number,
  t("mail.title") => @work_order.title,
  t("mail.priority") => mail_priority(@work_order.priority),
  t("mail.submitted") => @work_order.created_at.strftime("%Y-%m-%d %H:%M UTC")
) %>

<% if @work_order.requester_name.present? %>
<%= t("mail.submitted_by") %>: <%= @work_order.requester_name %> (<%= @work_order.requester_email %>)
<% end %>
<% if @work_order.description.present? %>
<%= t("mail.description") %>:
<%= @work_order.description %>
<% end %>

<%= t(".outro") %>

<%= t("mail.signature") %>
