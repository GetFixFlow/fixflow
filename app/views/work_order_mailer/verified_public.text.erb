<%= t("mail.hello") %>

<%= t(".intro") %>

<%= mail_fields(
  t("mail.work_order") => @work_order.work_order_number,
  t("mail.title") => @work_order.title,
  t("mail.verified") => @work_order.verified_at&.strftime("%Y-%m-%d %H:%M UTC") || t("mail.unknown")
) %>

<%= t("mail.completion_notes") %>:
<%= @work_order.completion_notes %>

<%= t(".outro") %>

<%= t("mail.signature") %>
