<%= t("mail.greeting", name: @assignee.full_name) %>

<%= t(".intro") %>

<%= mail_fields(
  t("mail.work_order") => @work_order.work_order_number,
  t("mail.title") => @work_order.title,
  t("mail.priority") => mail_priority(@work_order.priority),
  t("mail.due_date") => @work_order.due_date&.strftime("%Y-%m-%d") || t("mail.not_set")
) %>

<%= t("mail.log_in_to_view") %>

<%= t("mail.signature") %>
