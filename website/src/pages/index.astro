---
import Base from '../layouts/Base.astro';
import Code from '../components/Code.astro';
import Photo from '../components/Photo.astro';
import { doc, links, repo } from '../data/site';

const features = [
  { title: 'Work orders', text: 'Report, assign, start, hold, complete and verify. Checklists, photos, parts, hours and approval for costly work.', href: doc('work-orders') },
  { title: 'Preventive maintenance', text: 'Service by the calendar or by the count: running hours, kilometres or any meter. Work orders appear by themselves.', href: doc('meters') },
  { title: 'Assets and places', text: 'Every machine in its place, with manuals, warranty dates, downtime and a history of everything done to it.', href: doc('asset-documents') },
  { title: 'QR labels and scanning', text: 'Print labels, scan a machine with a phone or a handheld scanner, and let anyone report a problem without an account.', href: doc('scanning-and-labels') },
  { title: 'Parts and purchasing', text: 'Stock, low-stock warnings, purchase requests, approval, orders and receiving, and a list of vendors and contractors.', href: doc('purchasing') },
  { title: 'Sensors and alerts', text: 'Readings over REST or MQTT, alert rules, and work orders from what the machines tell you.', href: doc('iot') },
  { title: 'Reports', text: 'Cost, downtime, asset health and PM compliance, with PDF and CSV downloads, and saved reports emailed every week.', href: doc('reports') },
  { title: 'Works on a phone', text: 'An installable web app. A technician who loses signal keeps working, and the changes are sent when the signal is back.', href: doc('technician') },
  { title: 'English and Spanish', text: 'Screens and emails in the reader’s language. A language is a set of files, so adding one needs no code.', href: doc('translating') },
];

const ways = [
  { title: 'A public API and webhooks', text: 'Scoped API keys, an OpenAPI description, and signed webhooks for n8n, Zapier or your own programs.', href: doc('public-api') },
  { title: 'Your company’s sign-in', text: 'OpenID Connect (Keycloak, Microsoft Entra, Okta) and LDAP (Active Directory, OpenLDAP), with roles that follow groups.', href: doc('directory-sign-in') },
  { title: 'Plugins', text: 'Add a report or a notification channel by dropping a folder in. Two samples to start from.', href: doc('plugins') },
  { title: 'AI, only if you choose', text: 'Off until an administrator picks Claude, an OpenAI-compatible service, or a model on your own network.', href: doc('ai') },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Open source · self-hosted · AGPL-3.0</p>
        <h1>Maintenance management <em>you run yourself.</em></h1>
        <p class="lede">FixFlow is a free CMMS: work orders, preventive maintenance, assets, parts, sensors and reports, in a web app that also works on a phone. It runs on your server and your data stays there.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/install/">Install FixFlow</a>
          <a class="btn btn-ghost" href="/features/">See what it does</a>
        </div>
        <ul class="hero-facts">
          <li>One script installs it on a fresh Linux server</li>
          <li>Every feature is in the open code</li>
          <li>A new release the first Tuesday of each month</li>
        </ul>
      </div>

      <figure class="wo" style="margin:0">
        <div class="wo-top">
          <span class="tag">One work order, start to finish</span>
          <span class="title">“Pump on line 3 is leaking oil”</span>
        </div>
        <ol class="wo-steps">
          <li><div><b>Reported</b><span>Someone scans the pump’s QR label and describes the problem. No account needed.</span></div></li>
          <li><div><b>Assigned</b><span>A manager gives it to a technician. The schedule shows who is free.</span></div></li>
          <li><div><b>In progress</b><span>Started on a phone, with the checklist, photos and parts. Works without signal.</span></div></li>
          <li><div><b>Completed</b><span>Hours and parts are counted into the cost, and the machine’s history grows.</span></div></li>
          <li class="is-last"><div><b>Verified</b><span>Checked by someone other than the person who did the work.</span></div></li>
        </ol>
        <figcaption class="wo-foot">The real status flow, described in <a href={doc('work-orders')}>Work orders and maintenance</a>.</figcaption>
      </figure>
    </div>
  </section>

  <section class="photo-band" aria-label="On the plant floor">
    <Photo slug="home-floor" ratio="21 / 8" size="2400 × 900" title="a technician at a machine" alt="A maintenance technician checking a pump with a tablet in hand"
      brief="Wide, daylight, a real plant or workshop: a technician with a phone or tablet beside a pump or motor. Avoid staged smiles and hard hats on a white background." />
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>What a maintenance team reaches for</h2>
        <p class="lede">Each one links to the page in the documentation that explains it.</p>
      </div>
      <ul class="rows">
        {features.map((f) => (
          <li>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
      <p style="margin-top:28px"><a href="/features/"><strong>All features, grouped by what you want to do →</strong></a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head">
        <h2>Your company’s software, on your company’s server</h2>
      </div>
      <div class="principles">
        <div>
          <h3>On your server</h3>
          <p>Each company installs its own copy: on a server in your building, on a cloud machine you rent, or on a Kubernetes cluster. Your work orders and photos never pass through us, and there is nothing to sign up for.</p>
        </div>
        <div>
          <h3>Open all the way</h3>
          <p>AGPL-3.0, with every feature in the open code. Nothing is held back for people who pay, and the project says so on its <a href="/support/">support page</a>.</p>
        </div>
        <div>
          <h3>Honest about its limits</h3>
          <p>The docs say what they do not cover yet. A <a href={doc('security-review')}>security review</a> lists what was found and fixed, and the limits that remain.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Plugs into what you already run</h2>
      </div>
      <ul class="rows">
        {ways.map((f) => (
          <li>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap grid grid-2" style="align-items:center;gap:clamp(28px,5vw,64px)">
      <div>
        <h2>Installing is one script</h2>
        <p class="lede" style="margin-top:16px">It installs Docker and FixFlow, starts it, and turns on HTTPS with a free certificate if you give it a name. The first page it opens creates your company and the first administrator.</p>
        <div class="btn-row" style="margin-top:26px">
          <a class="btn btn-primary" href="/install/">Read the install guide</a>
          <a class="btn btn-ghost" href={doc('lite')}>Lite install for 2 GB</a>
        </div>
      </div>
      <Code id="home-install" caption="on a fresh Ubuntu or Debian server"><span class="c"># download the installer and run it</span>
curl -fsSLO https://raw.githubusercontent.com/GetFixFlow/fixflow/main/deploy/install.sh
sudo sh install.sh --domain fixflow.example.com --email you@example.com</Code>
    </div>
  </section>

  <section>
    <div class="wrap grid grid-2" style="gap:clamp(28px,5vw,64px);align-items:start">
      <div>
        <h2>Kept going by the people who use it</h2>
        <p class="lede" style="margin-top:16px">New versions come out on the first Tuesday of every month, with what you have to do before upgrading written first. Ask questions, show what you built, or pick up a small issue.</p>
        <Photo class="photo-side" slug="home-team" ratio="3 / 2" size="1500 × 1000" title="a team at a workbench" alt="Maintenance staff talking over a machine"
          brief="Two or three people in work clothes talking over a machine or a screen. Candid, not posed." />
      </div>
      <div class="grid">
        <article class="card link"><h3><a href={links.discussions} rel="noopener">Ask in Discussions</a></h3><p>Questions, ideas, and what other companies do.</p></article>
        <article class="card link"><h3><a href="/open-source/">Help build it</a></h3><p>Code, translations, docs, or writing down every stumble in an install.</p></article>
        <article class="card link"><h3><a href="/support/">Paid help, if you want it</a></h3><p>Support contracts, setup help and sponsored features. The software is the same for everyone.</p></article>
      </div>
    </div>
  </section>

  <section class="band cta">
    <div class="wrap">
      <h2>Put it on a server of your own</h2>
      <p>Free, with no sign-up. If something is missing, wrong or confusing, that is useful: tell the project.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/install/">Install FixFlow</a>
        <a class="btn btn-ghost" href={repo} rel="noopener">View the code</a>
      </div>
    </div>
  </section>
</Base>
