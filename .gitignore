# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, except the template that is documented in the README.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# macOS
.DS_Store

# Frontend
apps/web/node_modules/
apps/web/dist/
apps/web/.env.development
apps/web/.env.production

# Ruby vendor
/vendor/

# Claude Code local state
/.claude/

# Database dumps made by `make backup`: they hold all of a company's data
backup_*.sql
backup_*.sql.gz

# Written by bin/upgrade, read by bin/rollback.
/.fixflow_upgrade

# The private key of an HTTPS certificate (README, "HTTPS").
/certs/
